### 2.DATA PREPARATION

hat_work <- phys_inter %>%
  merge(., y = hat_waves, by = "lopnr", all = TRUE) %>%
  mutate(birthday_char = as.numeric(birthday)) %>%                                    # define birthday_char as a character var instead of numeric
  dplyr::select(-birthday) %>%                                                        # delete birthday
  mutate(birthday = ymd(birthday_char)) %>%                                           # define birthdate as a date var
  rename(date_baseline_char = läkdat_c1_0) %>%                                        # rename läkdat_c1_0 as date_baseline_char
  mutate(date_baseline = as.Date(date_baseline_char, format = "%Y%m%d")) %>%          # define date_baseline as a date var
  mutate(date_fu1_char = läk_c1_1_81) %>%                                             # define date_fu1_char from läk_c1_1_81
  mutate(date_fu1_char = ifelse(date_fu1_char == "", läk_c1_1_66, date_fu1_char)) %>% # replace date_fu1_char = läk_c1_1_66 if date_fu1_char is NA
  mutate(date_fu1 = as.Date(date_fu1_char, format = "%y%m%d")) %>%                    # define date_fu1 from date_fu1_char
  mutate(date_fu2_char = läk_c1_2_81_2010) %>%                                        # define date_fu2_char from läk_c1_2_81_2010
  mutate(date_fu2_char = ifelse(date_fu2_char == "", läk_c1_2_84, date_fu2_char)) %>% # replace date_fu2_char = läk_c1_2_84 if date_fu2_char is NA
  mutate(date_fu2 = as.Date(date_fu2_char, format = "%y%m%d")) %>%                    # define date_fu2 from date_fu2_char
  mutate(date_fu3_char = läk_c1_3_87_2010) %>%                                        # define date_fu3_char from läk_c1_3_87_2010
  mutate(date_fu3_char = ifelse(date_fu3_char == "", läk_c1_3_84, date_fu3_char)) %>% # replace date_fu3_char = läk_c1_3_84 if date_fu3_char is NA
  mutate(date_fu3 = as.Date(date_fu3_char, format = "%y%m%d")) %>%                    # define date_fu3 from date_fu3_char
  mutate(date_fu4_char = läk_c1_4_90) %>%                                             # define date_fu1_char from läk_c1_4_90
  mutate(date_fu4 = as.Date(date_fu4_char, format = "%y%m%d")) %>%                    # define date_fu1 from date_fu1_char
  rename(sc_baseline = Sc0, sc_fu1 = Sc1, sc_fu2 = Sc2, sc_fu3 = Sc3, sc_fu4 = Sc4) %>%
  dplyr::select(lopnr,birthday,date_baseline,date_fu1,date_fu2,date_fu3,date_fu4,sc_baseline,sc_fu1,sc_fu2,sc_fu3,sc_fu4) %>%
  mutate(age_baseline = time_length(interval(birthday,date_baseline), "years")) %>%
  mutate(age_fu1 = time_length(interval(birthday,date_fu1), "years")) %>%
  mutate(age_fu2 = time_length(interval(birthday,date_fu2), "years")) %>%
  mutate(age_fu3 = time_length(interval(birthday,date_fu3), "years")) %>%
  mutate(age_fu4 = time_length(interval(birthday,date_fu4), "years"))

