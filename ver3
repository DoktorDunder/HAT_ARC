# Pivot date columns to long format
hat_work_date_pivoted <- hat_work %>%
  pivot_longer(
    cols = starts_with("date_"),
    names_to = "timepoint",
    values_to = "date"
  ) %>%
  mutate(timepoint = gsub("date_", "age_", timepoint))  # Ensure timepoint names match

# Pivot age columns to long format
hat_work_age_pivoted <- hat_work %>%
  pivot_longer(
    cols = starts_with("age_"),
    names_to = "timepoint",
    values_to = "age"
  ) %>%
  mutate(timepoint = gsub("age_", "age_", timepoint))  # Ensure matching names

# Pivot sc_ indicator columns to long format
hat_work_sc_pivoted <- hat_work %>%
  pivot_longer(
    cols = starts_with("sc_"),
    names_to = "timepoint",
    values_to = "sc"
  ) %>%
  mutate(timepoint = gsub("sc_", "age_", timepoint))  # Ensure matching names

# Merge all long tables
hat_work_long <- hat_work_date_pivoted %>%
  left_join(hat_work_age_pivoted %>% 
              select(lopnr, timepoint, age), by = c("lopnr", "timepoint")) %>%
  left_join(hat_work_sc_pivoted 
            %>% select(lopnr, timepoint, sc), by = c("lopnr", "timepoint")) %>%
  dplyr::select(lopnr, timepoint, birthday, date, age, sc) %>% # Reorder columns 
  mutate(timepoint = ifelse(timepoint == "age_baseline", "Baseline", timepoint)) %>%
  mutate(timepoint = ifelse(timepoint == "age_fu1", "Follow Up 1", timepoint)) %>%
  mutate(timepoint = ifelse(timepoint == "age_fu2", "Follow Up 2", timepoint)) %>%
  mutate(timepoint = ifelse(timepoint == "age_fu3", "Follow Up 3", timepoint)) %>%
  mutate(timepoint = ifelse(timepoint == "age_fu4", "Follow Up 4", timepoint))





